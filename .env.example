# Copy this file to a new file named ".env" and replace the placeholder values.
# You only need to fill in the providers you want to use.
# Never commit your real .env file - it contains your secret API keys.
#
# Model names change over time. Pick a model your account can access:
#   OpenAI:    https://platform.openai.com/docs/models
#   Gemini:    https://ai.google.dev/gemini-api/docs/models
#   Anthropic: https://docs.anthropic.com/en/docs/about-claude/models

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_available_openai_model

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_available_gemini_model

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=your_available_claude_model
